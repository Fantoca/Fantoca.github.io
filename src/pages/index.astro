---
import Layout from '../layouts/Layout.astro';
---

<Layout title="MOCH. ANGGIK FANTOCA · PORTFOLIO">
  <noscript><div class="no-script">Interactive navigation needs JavaScript. <a href="mailto:fantocaa17@gmail.com">Email me</a> or <a href="/projects/goravel-inertia-react/">read a case study</a>.</div></noscript>
  <!-- Background art layers -->
  <div id="bg" aria-hidden="true">
    <div class="bg-layer" id="bg-stripes"></div>
    <svg class="bg-star bg-star--top-left" viewBox="0 0 100 100">
      <polygon points="50,0 60,35 98,35 68,57 78,94 50,72 22,94 32,57 2,35 40,35" fill="#000"></polygon>
    </svg>
    <svg class="bg-star s2 bg-star--bottom-right" viewBox="0 0 100 100">
      <polygon points="50,0 60,35 98,35 68,57 78,94 50,72 22,94 32,57 2,35 40,35" fill="#fff"></polygon>
    </svg>
    <!-- Per-screen menu artwork: /assets/menus/<screen>.jpg
         Each falls back to the CSS stripes if its file is missing -->
    <img class="menu-art" id="art-home" src="/assets/menus/home.jpg" alt="" onload="document.body.classList.add('has-art-home')" onerror="this.remove()" />
    <img class="menu-art" id="art-skills" src="/assets/menus/skills.jpg" alt="" onload="document.body.classList.add('has-art-skills')" onerror="this.remove()" />
    <img class="menu-art" id="art-about" src="/assets/menus/about.jpg" alt="" onload="document.body.classList.add('has-art-about')" onerror="this.remove()" />
    <img class="menu-art" id="art-contact" src="/assets/menus/contact.jpg" alt="" onload="document.body.classList.add('has-art-contact')" onerror="this.remove()" />
    <div class="bg-layer" id="bg-halftone"></div>
    <div class="bg-layer" id="bg-vignette"></div>
  </div>
  <div id="slash" aria-hidden="true"></div>


  <!-- Screen transition wipe -->
  <div id="wipe" aria-hidden="true">
    <div class="pane p3"></div>
    <div class="pane p2"></div>
    <div class="pane p1"></div>
    <div class="flash"></div>
  </div>

  <!-- Persona 5 — Press any button to unlock SFX (required by Zen/Firefox autoplay policy) -->
  <div id="enter-overlay" role="button" tabindex="0" aria-label="Enter portfolio">
    <div class="enter-bg" aria-hidden="true">
      <svg class="enter-star" viewBox="0 0 100 100" aria-hidden="true"><polygon points="50,0 60,35 98,35 68,57 78,94 50,72 22,94 32,57 2,35 40,35" fill="#000"/></svg>
      <svg class="enter-star s2" viewBox="0 0 100 100" aria-hidden="true"><polygon points="50,0 60,35 98,35 68,57 78,94 50,72 22,94 32,57 2,35 40,35" fill="#fff"/></svg>
    </div>
    <div class="enter-content enter-content--naked enter-content--hero">
      <div class="enter-top" aria-hidden="true">
        <span class="enter-kicker enter-kicker--black">PORTFOLIO 2026</span>
        <span class="enter-kicker enter-kicker--alt">BASED IN INDONESIA</span>
      </div>
      <h2 class="enter-title enter-title--hero" aria-label="ANGGIK FANTOCA">
        <span class="ransom" data-ransom="ANGGIK">ANGGIK</span>
        <span class="ransom" data-ransom="FANTOCA">FANTOCA</span>
      </h2>
      <div class="enter-meta">
        <p class="enter-sub">FULL-STACK DEVELOPMENT · PRODUCT INTERFACES</p>
        <p class="enter-detail">Building interfaces, application logic and AI-assisted workflows.</p>
      </div>
      <div class="enter-cta">
        <span class="enter-btn" id="enter-btn"><span class="enter-btn__label">▶ ENTER PORTFOLIO ◀</span></span>
        <span class="enter-hint">tap · click · or press Enter</span>
      </div>
    </div>
  </div>

  <!-- Custom animated cursor + select sound -->
  <div id="cursor" aria-hidden="true"></div>
  <audio id="sfx-select" src="/assets/sfx/select.mp3" preload="none"></audio>

  <div id="shell">
    <div id="hud-top">
      <div id="audio-dock" class="audio-dock">
        <button id="sound-toggle" type="button" aria-pressed="true" aria-controls="music-player">SOUND ON</button>
        <button id="music-panel-toggle" type="button" aria-expanded="false" aria-controls="music-player">♫ MUSIC</button>
        <section id="music-player" class="music-player" aria-label="Background music" hidden>
          <div class="music-player__head">
            <span>NOW PLAYING</span>
            <button id="music-close" type="button" aria-label="Close music player">×</button>
          </div>
          <p id="music-title">Persona 5 Royal Relaxing Mix</p>
          <div id="youtube-player" class="youtube-player" aria-label="YouTube music player"></div>
          <label class="music-volume" for="music-volume">
            <span>VOLUME</span>
            <input id="music-volume" type="range" min="0" max="100" step="1" value="20" />
            <output id="music-volume-value" for="music-volume">20%</output>
          </label>
          <div id="music-list" class="music-list" aria-label="Choose a mix"></div>
          <a id="music-youtube-link" href="https://www.youtube.com/watch?v=auXYzfrmVbw" target="_blank" rel="noopener">Open on YouTube ↗</a>
          <p class="music-note">Music is streamed from YouTube. Playback starts after your first interaction.</p>
        </section>
      </div>
      <div class="hud-tag">Portfolio // Moch. Anggik Fantoca</div>
      <div class="hud-tag alt">Indonesia · Full-Stack Development</div>
    </div>

    <main id="stage">

      <!-- HOME -->
      <section class="screen active" id="screen-home" aria-label="Main menu">
        <div id="intro-eyebrow">Take a look at my work</div>
        <h1 id="big-name" aria-label="Anggik Fantoca">
          <span class="ransom" data-ransom="ANGGIK">ANGGIK</span>
          <span class="ransom" data-ransom="FANTOCA">FANTOCA</span>
        </h1>
        <!-- Persona highlight: paksa huruf ke-3 ANGGIK jadi kotak hitam + huruf ke-4 jadi merah biar lebih modis -->
        <style is:global>
          #big-name .ransom[data-ransom="ANGGIK"] .ch:nth-child(3){background:var(--black) !important; color:var(--white) !important; padding:.02em .08em !important; margin:0 .03em !important;}
        </style>
        <p id="tagline">A full-stack developer focused on reliable web applications, AI-assisted development and practical business workflows. My UI/UX background helps me connect sound engineering decisions with clear product experiences.</p>
        <nav id="menu" aria-label="Sections">
          <button class="menu-item sel" data-target="projects" aria-label="Projects">
            <span class="ransom" data-ransom="PROJECTS">PROJECTS</span><span class="cursor-mark">◀</span>
          </button>
          <button class="menu-item" data-target="skills" aria-label="Skills">
            <span class="ransom" data-ransom="SKILLS">SKILLS</span><span class="cursor-mark">◀</span>
          </button>
          <button class="menu-item" data-target="about" aria-label="About">
            <span class="ransom" data-ransom="ABOUT">ABOUT</span><span class="cursor-mark">◀</span>
          </button>
          <button class="menu-item" data-target="contact" aria-label="Contact">
            <span class="ransom" data-ransom="CONTACT">CONTACT</span><span class="cursor-mark">◀</span>
          </button>
        </nav>
      </section>

      <!-- PROJECTS -->
      <section class="screen sub" id="screen-projects" aria-label="Projects">
        <div class="screen-head"><span class="ransom" data-ransom="PROJECTS">PROJECTS</span></div>
        <button class="back-hint" data-back>ESC · Back</button>
        <div class="grid-label"><span class="bar"></span>Featured</div>
        <div id="case-grid" class="grid"></div>
        <div class="grid-label"><span class="bar"></span>All Projects</div>
        <div id="feat-grid" class="grid"></div>
      </section>

      <!-- SKILLS -->
      <section class="screen sub" id="screen-skills" aria-label="Skills">
        <div class="screen-head"><span class="ransom" data-ransom="SKILLS">SKILLS</span></div>
        <button class="back-hint" data-back>ESC · Back</button>
        <div id="skills-body"></div>
      </section>

      <!-- ABOUT -->
      <section class="screen sub align-right" id="screen-about" aria-label="About">
        <div class="screen-head"><span class="ransom" data-ransom="ABOUT">ABOUT</span></div>
        <button class="back-hint" data-back>ESC · Back</button>
        <div class="paper about-copy">
          <figure class="about-photo">
            <img src="/assets/projects/portrait.png" alt="Anggik Fantoca" loading="lazy" />
            <figcaption>Anggik Fantoca · Indonesia</figcaption>
          </figure>
          <p>I am a full-stack developer with experience building and maintaining web applications that support operational, financial and event-management workflows. My work covers the full delivery cycle, from understanding requirements and structuring application flows to implementing, integrating and refining production-ready features.</p>
          <p>I have contributed to systems involving multi-tenant data isolation, role-based processes, transaction and finance workflows, and reusable application foundations. These projects have strengthened my ability to work across interconnected parts of a product while keeping maintainability, reliability and user needs in view.</p>
          <p>My earlier background in UI/UX and visual design complements my engineering work by helping me translate complex requirements into interfaces that are clear, consistent and practical. I am also interested in applied AI and use AI-assisted workflows for research, prototyping, debugging and documentation while keeping technical decisions and final implementation under deliberate review.</p>
          <p><a href="https://www.linkedin.com/in/mochammad-anggik-fantoca-424b7a1b2/" target="_blank" rel="noopener">Visit my LinkedIn ↗</a></p>
        </div>
        <a class="cv-btn" href="mailto:fantocaa17@gmail.com?subject=CV%20request"><span>Request my CV ↗</span></a>
      </section>

      <!-- CONTACT -->
      <section class="screen sub align-right" id="screen-contact" aria-label="Contact">
        <div class="screen-head"><span class="ransom" data-ransom="CONTACT">CONTACT</span></div>
        <button class="back-hint" data-back>ESC · Back</button>
        <div class="paper paper--narrow">
          <p>Have a web application, interface, or collaboration in mind? Tell me what you’re working on. You can send a message below or contact me directly.</p>
        </div>
        <div class="contact-list">
          <a class="contact-chip" href="mailto:fantocaa17@gmail.com"><span>Email ✉</span></a>
          <a class="contact-chip" href="https://github.com/Fantocaa" target="_blank" rel="noopener"><span>GitHub ↗</span></a>
          <a class="contact-chip" href="https://dribbble.com/Fantoca" target="_blank" rel="noopener"><span>Dribbble ↗</span></a>
          <a class="contact-chip" href="https://www.instagram.com/fantoca17/" target="_blank" rel="noopener"><span>Instagram ↗</span></a>
        </div>

        <!-- Message form — relayed to your inbox via formsubmit.co.
             NOTE: the first-ever submission emails you a one-time activation link. -->
        <form id="contact-form" class="paper paper--narrow">
          <div class="form-head">Send me a message</div>
          <p class="form-note">Your name, email and message are sent through FormSubmit. You can also use the Email link above.</p>
          <label class="field">
            <span>Name</span>
            <input type="text" name="name" required maxlength="100" autocomplete="name" />
          </label>
          <label class="field">
            <span>Your email</span>
            <input type="email" name="email" required maxlength="150" autocomplete="email" />
          </label>
          <label class="field">
            <span>Message</span>
            <textarea name="message" required rows="5" maxlength="3000"></textarea>
          </label>
          <!-- honeypot: bots fill this, humans never see it -->
          <input type="text" name="_honey" tabindex="-1" autocomplete="off" class="honeypot" aria-hidden="true" />
          <div class="form-foot">
            <button type="submit" class="cv-btn form-send"><span>Send it ➤</span></button>
            <div id="form-status" role="status"></div>
          </div>
        </form>
      </section>

    </main>

    <section id="case-view" class="document-page" aria-label="Project case study" hidden></section>

    <div id="hud-bottom">
      <span><span class="key">↑↓</span>Select</span>
      <span><span class="key">Enter</span>Confirm</span>
      <span><span class="key">Esc</span>Back</span>
      <span id="clock"></span>
    </div>
  </div>

  <script>
    import '../scripts/controller.js';
  </script>
</Layout>
