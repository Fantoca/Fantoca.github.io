<div class="audio-dock direct-case-audio">
  <button id="sound-toggle" type="button" aria-pressed="true" aria-controls="music-player">SOUND ON</button>
  <button id="music-panel-toggle" type="button" aria-expanded="false" aria-controls="music-player">♫ MUSIC</button>
  <section id="music-player" class="music-player" aria-label="Background music" hidden>
    <div class="music-player__head">
      <span>NOW PLAYING</span>
      <button id="music-close" type="button" aria-label="Close music player">×</button>
    </div>
    <p id="music-title">Persona 5 Royal Relaxing Mix</p>
    <div id="youtube-player" class="youtube-player" aria-label="YouTube music player"></div>
    <label class="music-volume" for="music-volume">
      <span>VOLUME</span>
      <input id="music-volume" type="range" min="0" max="100" step="1" value="20" />
      <output id="music-volume-value" for="music-volume">20%</output>
    </label>
    <div id="music-list" class="music-list" aria-label="Choose a mix"></div>
    <a id="music-youtube-link" href="https://www.youtube.com/watch?v=auXYzfrmVbw" target="_blank" rel="noopener">Open on YouTube ↗</a>
    <p class="music-note">Music is streamed from YouTube. Playback starts after your first interaction.</p>
  </section>
</div>

<div id="hud-bottom" class="direct-case-hud">
  <span><span class="key">Esc</span>Back</span>
  <span><span class="key">↑</span>Top</span>
  <span id="clock"></span>
</div>

<script>
  import '../scripts/case-audio.js';
</script>
